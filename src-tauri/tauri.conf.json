{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wayland-spectre",
  "version": "0.1.0",
  "identifier": "dev.wanderingmonster.wayland-spectre",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "wayland-spectre",
        "width": 920,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
