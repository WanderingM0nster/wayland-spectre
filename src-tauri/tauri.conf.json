{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wayland-spectre",
  "version": "0.1.0",
  "identifier": "dev.wanderingmonster.wayland-spectre",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "wayland-spectre",
        "width": 920,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwayland-client0",
          "libdbus-1-3",
          "libgcc-s1",
          "libssl3"
        ],
        "shortDescription": "Wayland screen sharing diagnostics for KDE Plasma + NVIDIA",
        "longDescription": "Diagnose all eight failure layers for Wayland screen sharing on KDE Plasma with NVIDIA open kernel modules. Covers portal, PipeWire, KWin plugin state, and Wayland globals in a single pass."
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}

